{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "projects": {
    "apigateway": {
      "type": "application",
      "root": "src/apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "src/apps/api-gateway/src",
      "compilerOptions": {
        "assets": [
          "proto/*.proto"
        ],
        "watchAssets": true
      }
    },
    "auth": {
      "type": "application",
      "root": "src/apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "src/apps/auth-service/src",
      "compilerOptions": {
        "assets": [
          "proto/*.proto"
        ],
        "watchAssets": true
      }
    }
  }
}